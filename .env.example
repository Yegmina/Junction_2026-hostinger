# Cala data layer (https://console.cala.ai/api-keys). Without it the app uses a fictional demo dataset.
CALA_API_KEY=
# OpenAI analysis. Without it the app uses a deterministic demo analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
REQUEST_TIMEOUT_SECONDS=120
# Max analyses per client IP per hour (protects API credits on a public demo)
RATE_LIMIT_PER_HOUR=30
# Comma-separated origins allowed to call the API directly (the Docker setup uses same-origin via nginx)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_PORT=8080
# Google Gemini analysis (used when OPENAI_API_KEY is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional: smaller Gemini model used if the main one fails twice
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Live web (Junction tech challenges). Each is optional; the step is skipped without its key.
# Context.dev: company profiles and site scraping (https://context.dev/dashboard/api-keys)
CONTEXT_DEV_API_KEY=
# Oxylabs Web API: live search and scrape (https://dashboard.oxylabs.io)
OXYLABS_WEB_API_KEY=
# NVIDIA Build: Nemotron audits the shortlist (https://build.nvidia.com)
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# on = let Nemotron reason first (~55 s instead of ~3 s)
NEMOTRON_REASONING=

# Aiven (optional). Without them, reports and the cache are files in the oracle_data volume.
# Aiven for PostgreSQL service URI: saved reports and cross-report investor history
DATABASE_URL=
# Aiven for Valkey service URI (rediss://...): API cache and the shared rate limit
VALKEY_URL=

# Optional: require this code for live runs (examples and saved reports stay public)
ACCESS_CODE=
# Optional: public hostname for the HTTPS overlay (docker-compose.https.yml)
DOMAIN=
