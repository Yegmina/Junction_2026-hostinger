# Cala data layer (https://console.cala.ai/api-keys). Without it the app uses a fictional demo dataset.
CALA_API_KEY=
# OpenAI analysis. Without it the app uses a deterministic demo analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
REQUEST_TIMEOUT_SECONDS=120
# Max analyses per client IP per hour (protects API credits on a public demo)
RATE_LIMIT_PER_HOUR=30
# Comma-separated origins allowed to call the API directly (the Docker setup uses same-origin via nginx)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_PORT=8080
# Google Gemini analysis (used when OPENAI_API_KEY is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
